{
    "name": "nexora",
    "private": "true",
    "version": "1.15.16.0",
    "description": "A community Discord client mod with a broad plugin ecosystem",
    "homepage": "https://github.com/EchoSpring-max/Nexora#readme",
    "bugs": {
        "url": "https://github.com/EchoSpring-max/Nexora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EchoSpring-max/Nexora.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "EchoSpring",
    "scripts": {
        "build": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs",
        "buildStandalone": "pnpm build --standalone",
        "buildInstaller": "pnpm buildStandalone && dotnet publish installer/NexoraInstaller.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishDir=../dist/installer/",
        "buildUnixInstallers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/packageUnixInstallers.ps1",
        "buildWeb": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generateDevsList": "tsx scripts/generateDevsList.ts",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateEquicordPluginJson": "tsx scripts/generatePluginList.ts --equicord",
        "generateVencordPluginJson": "tsx scripts/generatePluginList.ts --vencord",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/runInstaller.mjs -- --install",
        "uninject": "node scripts/runInstaller.mjs -- --uninstall",
        "repair": "node scripts/runInstaller.mjs -- --repair",
        "lint": "eslint",
        "lint-styles": "stylelint \"src/**/*.css\" --ignore-pattern src/userplugins",
        "lint-styles:fix": "pnpm lint-styles --fix",
        "lint:fix": "pnpm lint --fix",
        "lint:intl": "node scripts/lintIntl.mjs",
        "lint:patches": "node scripts/lintPatches.mjs",
        "test": "pnpm buildStandalone && pnpm testTsc && pnpm lint:fix && pnpm lint-styles && pnpm lint:intl && pnpm lint:patches && pnpm generatePluginJson",
        "testWeb": "pnpm lint:fix && pnpm buildWeb && pnpm testTsc",
        "testTsc": "tsc --noEmit"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "catalog:",
        "@ffmpeg/util": "catalog:",
        "@intrnl/xxhash64": "catalog:",
        "@song-spotlight/api": "catalog:",
        "@streamparser/json": "catalog:",
        "@vap/core": "catalog:",
        "@vap/shiki": "catalog:",
        "@vencord/monaco-editor": "catalog:",
        "fflate": "catalog:",
        "gifenc": "catalog:",
        "gifuct-js": "catalog:",
        "idb": "catalog:",
        "jsqr": "catalog:",
        "nanoid": "catalog:",
        "native-file-system-adapter": "catalog:",
        "yaml-js": "catalog:"
    },
    "devDependencies": {
        "@electron/asar": "catalog:",
        "@stylistic/eslint-plugin": "catalog:",
        "@types/chrome": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/yazl": "catalog:",
        "@vencord/discord-types": "link:packages/discord-types",
        "diff": "catalog:",
        "esbuild": "catalog:",
        "eslint": "catalog:",
        "eslint-import-resolver-alias": "catalog:",
        "eslint-plugin-react": "catalog:",
        "eslint-plugin-simple-header": "catalog:",
        "eslint-plugin-simple-import-sort": "catalog:",
        "eslint-plugin-unused-imports": "catalog:",
        "html-minifier-terser": "catalog:",
        "lodash": "catalog:",
        "md5": "catalog:",
        "moment": "catalog:",
        "p-limit": "catalog:",
        "puppeteer-core": "catalog:",
        "standalone-electron-types": "catalog:",
        "stylelint": "catalog:",
        "stylelint-config-standard": "catalog:",
        "svgo": "catalog:",
        "ts-patch": "catalog:",
        "ts-pattern": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "typescript-transform-paths": "catalog:",
        "zip-local": "catalog:"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22"
    }
}
